# Storage S3-compatível (Backblaze B2 por padrão — sem cartão de crédito)
# Endpoint e região aparecem no painel do B2 ao criar o bucket, ex.:
# STORAGE_ENDPOINT=https://s3.us-west-004.backblazeb2.com
# STORAGE_REGION=us-west-004
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Upstash Redis (estado dos jobs) — use a REST API, não a URL redis://
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# GitHub (dispara o workflow que roda o ffmpeg)
GH_PAT=
GITHUB_REPO_OWNER=emanuel02032009
GITHUB_REPO_NAME=animes
